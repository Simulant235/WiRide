<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Ergaenzt die globale Package-Source-Mapping-Konfiguration um die Projekt-Pakete -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <!-- Alle Pakete des Projekts kommen von nuget.org -->
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
