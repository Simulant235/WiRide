<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WiRide.Pages.ClientPage"
             BackgroundColor="#6C6C70"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">
        
        <!-- Settings Icon -->
        <ImageButton Grid.Row="0"
                    Source="settings_icon.png"
                    WidthRequest="40"
                    HeightRequest="40"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    BackgroundColor="Transparent"
                    Clicked="OnSettingsClicked"
                    Margin="0,20,0,0"/>

        <!-- Main Content -->
        <VerticalStackLayout Grid.Row="1" 
                            Spacing="40" 
                            VerticalOptions="Center">
            
            <!-- Status Label -->
            <VerticalStackLayout Spacing="5">
                <Label x:Name="StatusLabel"
                       Text="You are Client"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#30D158"
                       HorizontalOptions="Center"/>
                <Label x:Name="HostNameLabel"
                       Text="of {{Host}}"
                       FontSize="18"
                       TextColor="White"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Connection Section (visible when not connected) -->
            <VerticalStackLayout x:Name="ConnectionSection" 
                                Spacing="15"
                                IsVisible="True">
                <Label Text="Not Connected"
                       FontSize="18"
                       TextColor="#8E8E93"
                       HorizontalOptions="Center"/>

                <Button x:Name="ConnectButton"
                       Text="Connect to Network"
                       BackgroundColor="#007AFF"
                       TextColor="White"
                       CornerRadius="15"
                       Padding="30,15"
                       FontSize="18"
                       FontAttributes="Bold"
                       Clicked="OnConnectButtonClicked"
                       HorizontalOptions="Center"
                       WidthRequest="280"/>
            </VerticalStackLayout>

            <!-- Mute Button -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    WidthRequest="100"
                    HeightRequest="100"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMuteToggled"/>
                </Border.GestureRecognizers>
                
                <Label x:Name="MuteIcon"
                       Text="🎤"
                       FontSize="50"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <!-- Volume Slider -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Volume"
                       FontSize="14"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Slider x:Name="VolumeSlider"
                       Minimum="0"
                       Maximum="100"
                       Value="80"
                       MinimumTrackColor="#30D158"
                       MaximumTrackColor="#3A3A3C"
                       ThumbColor="White"
                       WidthRequest="300"
                       ValueChanged="OnVolumeChanged"/>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Network Info -->
        <VerticalStackLayout Grid.Row="2" Spacing="5" Margin="0,0,0,20">
            <Label x:Name="NetworkStatusLabel"
                   Text="Not Connected"
                   FontSize="12"
                   TextColor="White"
                   HorizontalOptions="Center"/>
            <Label x:Name="LatencyLabel"
                   Text="Latency: -"
                   FontSize="12"
                   TextColor="#8E8E93"
                   HorizontalOptions="Center"/>
            <Button x:Name="DisconnectButton"
                   Text="Disconnect"
                   BackgroundColor="#FF3B30"
                   TextColor="White"
                   CornerRadius="10"
                   Padding="20,10"
                   Clicked="OnDisconnectClicked"
                   HorizontalOptions="Center"
                   IsVisible="False"/>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
