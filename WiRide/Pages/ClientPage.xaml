<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:app="clr-namespace:WiRide"
             x:Class="WiRide.Pages.ClientPage"
             Style="{StaticResource WrPage}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,16">

        <!-- Kopfzeile -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,8,0,16">
            <Button Text="{x:Static app:Icons.ArrowBack}" Style="{StaticResource WrIconButton}" Clicked="OnBackClicked" />
            <Label Grid.Column="1" Text="{app:Tr GroupJoin}" Style="{StaticResource WrTitle}" />
            <Button Grid.Column="2" Text="{x:Static app:Icons.QrScanner}" Style="{StaticResource WrIconButton}" Clicked="OnScanQrClicked" />
            <Button Grid.Column="3" Text="{x:Static app:Icons.Settings}" Style="{StaticResource WrIconButton}" Clicked="OnSettingsClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">

                <!-- Status -->
                <Border Style="{StaticResource WrCard}">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Ellipse x:Name="StatusDot" WidthRequest="12" HeightRequest="12" Fill="{StaticResource WrTextMuted}" VerticalOptions="Center" />
                            <Label x:Name="StatusLabel" Grid.Column="1" Text="{app:Tr ClientNotConnected}" Style="{StaticResource WrBody}" FontAttributes="Bold" />
                        </Grid>
                        <Label x:Name="DetailLabel" Text="{app:Tr ClientScanHint}" Style="{StaticResource WrCaption}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Verbinden -->
                <VerticalStackLayout x:Name="ConnectSection" Spacing="12">
                    <Button Text="{app:Tr ClientJoinQr}"
                            Style="{StaticResource WrPrimaryButton}"
                            ContentLayout="Left,10"
                            Clicked="OnScanQrClicked">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Icons" Glyph="{x:Static app:Icons.Camera}" Color="{StaticResource WrOnAccent}" Size="22" />
                        </Button.ImageSource>
                    </Button>
                    <Button Text="{app:Tr ClientSearch}"
                            Style="{StaticResource WrSecondaryButton}"
                            ContentLayout="Left,10"
                            Clicked="OnSearchClicked">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Icons" Glyph="{x:Static app:Icons.WifiFind}" Color="{StaticResource WrText}" Size="22" />
                        </Button.ImageSource>
                    </Button>
                    <Button Text="{app:Tr ClientPickWifi}"
                            Style="{StaticResource WrSecondaryButton}"
                            ContentLayout="Left,10"
                            Clicked="OnPickWifiClicked">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Icons" Glyph="{x:Static app:Icons.Wifi}" Color="{StaticResource WrText}" Size="22" />
                        </Button.ImageSource>
                    </Button>
                    <Label Text="{app:Tr ClientManualIp}"
                           Style="{StaticResource WrCaption}"
                           TextDecorations="Underline"
                           HorizontalOptions="Center"
                           Padding="10">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnManualIpTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <ActivityIndicator x:Name="BusyIndicator" Color="{StaticResource WrAccent}" IsVisible="False" IsRunning="False" />
                </VerticalStackLayout>

                <!-- Mikrofon -->
                <VerticalStackLayout x:Name="MuteSection" Spacing="8" IsVisible="False" Margin="0,24">
                    <Border x:Name="MuteCircle"
                            WidthRequest="150"
                            HeightRequest="150"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            BackgroundColor="{StaticResource WrAccent}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="75" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMuteToggled" />
                        </Border.GestureRecognizers>
                        <Label x:Name="MuteIcon" Text="{x:Static app:Icons.Mic}" Style="{StaticResource WrIcon}" FontSize="68" TextColor="{StaticResource WrOnAccent}" />
                    </Border>
                    <Label x:Name="MuteLabel" Style="{StaticResource WrCaption}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <ContentView x:Name="QuickHost" IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>

        <Button x:Name="DisconnectButton"
                Grid.Row="2"
                Text="{app:Tr ClientDisconnect}"
                Style="{StaticResource WrDangerButton}"
                Clicked="OnDisconnectClicked"
                IsVisible="False"
                Margin="0,12,0,8" />
    </Grid>
</ContentPage>
