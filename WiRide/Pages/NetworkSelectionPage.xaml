<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:app="clr-namespace:WiRide"
             x:Class="WiRide.Pages.NetworkSelectionPage"
             Style="{StaticResource WrPage}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,16">

        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,8,0,8">
            <Label Text="WLAN wählen" Style="{StaticResource WrTitle}" />
            <Button x:Name="RefreshButton" Grid.Column="1" Text="{x:Static app:Icons.Refresh}" Style="{StaticResource WrIconButton}" Clicked="OnRefreshClicked" />
            <Button Grid.Column="2" Text="{x:Static app:Icons.Close}" Style="{StaticResource WrIconButton}" Clicked="OnCancelClicked" />
        </Grid>

        <Label Grid.Row="1"
               Text="WiRide-Gruppen beginnen mit „DIRECT-WR“. Netzwerke des Hosts stehen oben."
               Style="{StaticResource WrCaption}"
               Margin="4,0,0,12" />

        <Grid Grid.Row="2">
            <CollectionView x:Name="NetworksListView" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource WrCard}" Padding="16,14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNetworkSelected" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Text="{x:Static app:Icons.Wifi}" Style="{StaticResource WrIcon}" FontSize="22" TextColor="{StaticResource WrAccent}" />
                                <Label Grid.Column="1" Text="{Binding .}" Style="{StaticResource WrBody}" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="2" Text="{x:Static app:Icons.ChevronRight}" Style="{StaticResource WrIcon}" FontSize="22" TextColor="{StaticResource WrTextMuted}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="NoNetworksLabel"
                   Text="Keine Netzwerke gefunden. Ist der Host gestartet und WLAN eingeschaltet?"
                   Style="{StaticResource WrCaption}"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   IsVisible="False" />

            <ActivityIndicator x:Name="LoadingIndicator"
                               Color="{StaticResource WrAccent}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               IsVisible="False" />
        </Grid>
    </Grid>
</ContentPage>
