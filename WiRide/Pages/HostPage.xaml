<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:app="clr-namespace:WiRide"
             x:Class="WiRide.Pages.HostPage"
             Style="{StaticResource WrPage}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,16">

        <!-- Kopfzeile -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,8,0,16">
            <Button Text="{x:Static app:Icons.ArrowBack}" Style="{StaticResource WrIconButton}" Clicked="OnBackClicked" />
            <Label Grid.Column="1" Text="{app:Tr HostTitle}" Style="{StaticResource WrTitle}" />
            <Button Grid.Column="2" Text="{x:Static app:Icons.Settings}" Style="{StaticResource WrIconButton}" Clicked="OnSettingsClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">

                <!-- Status -->
                <Border Style="{StaticResource WrCard}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Ellipse x:Name="StatusDot" WidthRequest="12" HeightRequest="12" Fill="{StaticResource WrTextMuted}" VerticalOptions="Center" />
                            <Label x:Name="StatusLabel" Grid.Column="1" Text="{app:Tr HostReady}" Style="{StaticResource WrBody}" FontAttributes="Bold" />
                        </Grid>

                        <Label x:Name="IdleHint"
                               Text="{app:Tr HostIdleHint}"
                               Style="{StaticResource WrCaption}" />

                        <Grid x:Name="NetworkInfo" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="10" ColumnSpacing="12" IsVisible="False">
                            <Label Text="{x:Static app:Icons.Wifi}" Style="{StaticResource WrIcon}" FontSize="20" TextColor="{StaticResource WrTextMuted}" />
                            <Label x:Name="SsidLabel" Grid.Column="1" Style="{StaticResource WrBody}" FontSize="15" />
                            <Label Grid.Row="1" Text="{x:Static app:Icons.Lock}" Style="{StaticResource WrIcon}" FontSize="20" TextColor="{StaticResource WrTextMuted}" />
                            <Label x:Name="PasswordLabel" Grid.Row="1" Grid.Column="1" Style="{StaticResource WrBody}" FontSize="15" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Row="2" Text="{x:Static app:Icons.Router}" Style="{StaticResource WrIcon}" FontSize="20" TextColor="{StaticResource WrTextMuted}" />
                            <Label x:Name="IpLabel" Grid.Row="2" Grid.Column="1" Style="{StaticResource WrCaption}" VerticalOptions="Center" />
                        </Grid>

                        <Button x:Name="QrButton"
                                Text="{app:Tr HostQrButton}"
                                Style="{StaticResource WrSecondaryButton}"
                                ContentLayout="Left,10"
                                Clicked="OnQrClicked"
                                IsVisible="False">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="Icons" Glyph="{x:Static app:Icons.QrCode}" Color="{StaticResource WrText}" Size="22" />
                            </Button.ImageSource>
                        </Button>
                    </VerticalStackLayout>
                </Border>

                <!-- Mikrofon -->
                <VerticalStackLayout x:Name="MuteSection" Spacing="8" IsVisible="False" Margin="0,8">
                    <Border x:Name="MuteCircle"
                            WidthRequest="132"
                            HeightRequest="132"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            BackgroundColor="{StaticResource WrAccent}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="66" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMuteToggled" />
                        </Border.GestureRecognizers>
                        <Label x:Name="MuteIcon" Text="{x:Static app:Icons.Mic}" Style="{StaticResource WrIcon}" FontSize="60" TextColor="{StaticResource WrOnAccent}" />
                    </Border>
                    <Label x:Name="MuteLabel" Text="{app:Tr MicOn}" Style="{StaticResource WrCaption}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Rider -->
                <VerticalStackLayout x:Name="RidersSection" Spacing="8" IsVisible="False">
                    <Label x:Name="RidersTitle" Text="{app:Tr RidersTitle}" Style="{StaticResource WrSectionTitle}" />
                    <Label x:Name="NoRidersLabel" Text="{app:Tr NoRiders}" Style="{StaticResource WrCaption}" Margin="4,0" />
                    <VerticalStackLayout x:Name="RidersList" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource WrCard}" Padding="14,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Label Text="{x:Static app:Icons.Person}" Style="{StaticResource WrIcon}" FontSize="22" TextColor="{StaticResource WrSuccess}">
                                            <Label.Triggers>
                                                <!-- Akku schwach oder Signal schlecht -> Warnfarbe -->
                                                <DataTrigger TargetType="Label" Binding="{Binding IsWeak}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource WrAccent}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Grid.Column="1" Text="{Binding ClientName}" Style="{StaticResource WrBody}" />
                                        <Label Grid.Column="2" Text="{Binding LatencyText}" Style="{StaticResource WrCaption}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <ContentView x:Name="QuickHost" IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>

        <Button x:Name="StartStopButton"
                Grid.Row="2"
                Text="{app:Tr GroupStart}"
                Style="{StaticResource WrPrimaryButton}"
                Clicked="OnStartStopClicked"
                Margin="0,12,0,8" />
    </Grid>
</ContentPage>
