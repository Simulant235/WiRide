<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:app="clr-namespace:WiRide"
             x:Class="WiRide.Pages.StartPage"
             Style="{StaticResource WrPage}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,16">

        <!-- Kopfzeile -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,8,0,0">
            <Border Style="{StaticResource WrIconCircle}" BackgroundColor="{StaticResource WrAccent}" WidthRequest="48" HeightRequest="48">
                <Label Text="{x:Static app:Icons.Motorcycle}" Style="{StaticResource WrIcon}" TextColor="{StaticResource WrOnAccent}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="WiRide" Style="{StaticResource WrTitle}" />
                <Label Text="{app:Tr StartTagline}" Style="{StaticResource WrCaption}" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="{x:Static app:Icons.Settings}" Style="{StaticResource WrIconButton}" Clicked="OnSettingsClicked" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="16" VerticalOptions="Center">

            <Label x:Name="GreetingLabel" Style="{StaticResource WrBody}" FontSize="{DynamicResource WrFontLarge}" Margin="4,0,0,8" />

            <!-- Schnellstart: letzte Sitzung -->
            <Border x:Name="QuickStartCard" Style="{StaticResource WrCard}" Padding="16,12" IsVisible="False"
                    Stroke="{StaticResource WrAccent}" StrokeThickness="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnQuickStartTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Label x:Name="QuickStartIcon" Style="{StaticResource WrIcon}" TextColor="{StaticResource WrAccent}" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label x:Name="QuickStartTitle" Style="{StaticResource WrBody}" FontAttributes="Bold" />
                        <Label x:Name="QuickStartDetail" Style="{StaticResource WrCaption}" />
                    </VerticalStackLayout>
                    <Ellipse x:Name="QuickStartDot" Grid.Column="2" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Host -->
            <Border Style="{StaticResource WrCard}" Padding="20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHostButtonClicked" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Style="{StaticResource WrIconCircle}" BackgroundColor="{StaticResource WrAccentSoft}" WidthRequest="60" HeightRequest="60">
                        <Label Text="{x:Static app:Icons.WifiTethering}" Style="{StaticResource WrIcon}" FontSize="30" TextColor="{StaticResource WrAccent}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{app:Tr GroupStart}" Style="{StaticResource WrBody}" FontSize="{DynamicResource WrFontLarge}" FontAttributes="Bold" />
                        <Label Text="{app:Tr StartHostDesc}" Style="{StaticResource WrCaption}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static app:Icons.ChevronRight}" Style="{StaticResource WrIcon}" TextColor="{StaticResource WrTextMuted}" />
                </Grid>
            </Border>

            <!-- Client -->
            <Border Style="{StaticResource WrCard}" Padding="20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnClientButtonClicked" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Style="{StaticResource WrIconCircle}" BackgroundColor="{StaticResource WrSuccessSoft}" WidthRequest="60" HeightRequest="60">
                        <Label Text="{x:Static app:Icons.Group}" Style="{StaticResource WrIcon}" FontSize="30" TextColor="{StaticResource WrSuccess}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{app:Tr GroupJoin}" Style="{StaticResource WrBody}" FontSize="{DynamicResource WrFontLarge}" FontAttributes="Bold" />
                        <Label Text="{app:Tr StartClientDesc}" Style="{StaticResource WrCaption}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static app:Icons.ChevronRight}" Style="{StaticResource WrIcon}" TextColor="{StaticResource WrTextMuted}" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Fusszeile -->
        <VerticalStackLayout Grid.Row="2" Spacing="8" Margin="0,0,0,8">
            <Button x:Name="AudioTestButton"
                    Text="Audio-Test (Debug)"
                    Style="{StaticResource WrSecondaryButton}"
                    Clicked="OnAudioTestButtonClicked"
                    IsVisible="False" />
            <Label Text="{app:Tr StartFooter}"
                   Style="{StaticResource WrCaption}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
