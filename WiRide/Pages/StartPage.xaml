<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WiRide.Pages.StartPage"
             BackgroundColor="#2C2C2E">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">
        
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,40,0,0">
            <Label Text="WiRide Intercom"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>
            <Label Text="Offline Motorcycle Communication"
                   FontSize="14"
                   TextColor="#8E8E93"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Main Content -->
        <VerticalStackLayout Grid.Row="1" 
                            Spacing="20" 
                            VerticalOptions="Center"
                            Margin="0,40,0,0">
            
            <!-- Host Button -->
            <Border BackgroundColor="#FFD60A"
                    StrokeThickness="0"
                    Padding="0"
                    HeightRequest="120"
                    Margin="0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHostButtonClicked"/>
                </Border.GestureRecognizers>
                
                <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="Start as Host"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#1C1C1E"
                           HorizontalOptions="Center"/>
                    <Label Text="Create a new group"
                           FontSize="14"
                           TextColor="#3A3A3C"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Client Button -->
            <Border BackgroundColor="#30D158"
                    StrokeThickness="0"
                    Padding="0"
                    HeightRequest="120"
                    Margin="0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnClientButtonClicked"/>
                </Border.GestureRecognizers>
                
                <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="Join as Client"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#1C1C1E"
                           HorizontalOptions="Center"/>
                    <Label Text="Connect to existing group"
                           FontSize="14"
                           TextColor="#1E3A1E"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Footer -->
        <Label Grid.Row="2" 
               Text="MVP v1.0"
               FontSize="12"
               TextColor="#8E8E93"
               HorizontalOptions="Center"
               Margin="0,0,0,20"/>
    </Grid>

</ContentPage>
