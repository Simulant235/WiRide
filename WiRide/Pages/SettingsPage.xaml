<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WiRide.Pages.SettingsPage"
             Title="Einstellungen"
             BackgroundColor="#1C1C1E">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label Text="Einstellungen"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,20,0,10"/>

            <Label Text="Rider-Name" TextColor="#8E8E93" FontSize="14"/>
            <Entry x:Name="NameEntry"
                   TextColor="White"
                   BackgroundColor="#3A3A3C"
                   MaxLength="24"/>

            <Label Text="Lautstaerke" TextColor="#8E8E93" FontSize="14"/>
            <Slider x:Name="VolumeSlider"
                    Minimum="0"
                    Maximum="1"
                    MinimumTrackColor="#30D158"/>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Automatisch neu verbinden"
                       TextColor="White"
                       VerticalOptions="Center"/>
                <Switch x:Name="AutoReconnectSwitch" Grid.Column="1" OnColor="#30D158"/>
            </Grid>

            <Label Text="Erweitert" TextColor="#FFD60A" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0"/>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Opus-Kompression (spart Bandbreite)"
                       TextColor="White"
                       VerticalOptions="Center"/>
                <Switch x:Name="OpusSwitch" Grid.Column="1" OnColor="#30D158"/>
            </Grid>

            <Label Text="Server-Port (alle Geraete gleich)" TextColor="#8E8E93" FontSize="14"/>
            <Entry x:Name="PortEntry"
                   Keyboard="Numeric"
                   TextColor="White"
                   BackgroundColor="#3A3A3C"/>

            <Label Text="Audio-Sample-Rate (alle Geraete gleich)" TextColor="#8E8E93" FontSize="14"/>
            <Picker x:Name="SampleRatePicker"
                    TextColor="White"
                    BackgroundColor="#3A3A3C"/>

            <Label x:Name="HintLabel"
                   Text="Aenderungen an Port, Sample-Rate und Opus gelten ab der naechsten Verbindung."
                   TextColor="#8E8E93"
                   FontSize="12"/>

            <Button Text="Speichern"
                    BackgroundColor="#30D158"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="OnSaveClicked"
                    Margin="0,10,0,0"/>

            <Button Text="Abbrechen"
                    BackgroundColor="#3A3A3C"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="OnCancelClicked"/>

            <Label x:Name="VersionLabel"
                   TextColor="#8E8E93"
                   FontSize="12"
                   HorizontalOptions="Center"
                   Margin="0,20,0,0"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
